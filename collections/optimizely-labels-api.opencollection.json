{
  "opencollection": "1.0.0",
  "info": {
    "name": "Optimizely Campaign REST Assets Labels API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Labels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List labels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.campaign.episerver.net/rest/labels"
          },
          "docs": "Returns a list of labels used for categorizing content in the CMP."
        }
      ]
    }
  ],
  "bundled": true
}