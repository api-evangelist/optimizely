{
  "opencollection": "1.0.0",
  "info": {
    "name": "Optimizely Campaign REST Assets Unsubscribes API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Unsubscribes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List unsubscribes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.campaign.episerver.net/rest/:clientId/unsubscribes",
            "params": [
              {
                "name": "clientId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the Optimizely Campaign client"
              }
            ]
          },
          "docs": "Returns a list of recipients who have unsubscribed from communications."
        },
        {
          "info": {
            "name": "Add an unsubscribe",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.campaign.episerver.net/rest/:clientId/unsubscribes",
            "params": [
              {
                "name": "clientId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the Optimizely Campaign client"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a recipient to the unsubscribe list."
        }
      ]
    }
  ],
  "bundled": true
}