{
  "opencollection": "1.0.0",
  "info": {
    "name": "Optimizely Campaign REST Assets Sites API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sites",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List sites",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.campaign.episerver.net/rest/site",
            "params": [
              {
                "name": "language",
                "value": "",
                "type": "query",
                "description": "The language code for content retrieval"
              }
            ]
          },
          "docs": "Returns a list of site definitions configured in the Optimizely CMS instance, including language settings and site URLs."
        }
      ]
    }
  ],
  "bundled": true
}